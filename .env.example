# Copie para .env e preencha. O .env NUNCA vai para o Git.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Langfuse (Settings → API Keys no projeto do Langfuse Cloud)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Na SDK v5 o nome é LANGFUSE_BASE_URL (LANGFUSE_HOST está depreciado).
# Região EU: https://cloud.langfuse.com · Região US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
